# ============================================================
# AXDOX Verify — Environment Variables
# Copy to .env.local (dev) and set in Vercel (prod).
# NEVER commit real secrets.
# ============================================================

# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Service role — SERVER ONLY. Bypasses RLS. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ---- Security ----
# 32+ byte random secret used to HMAC OTP codes and hash API keys.
# Generate: openssl rand -hex 32
OTP_PEPPER=change-me-64-hex-chars
API_KEY_PEPPER=change-me-another-64-hex-chars

# ---- Local dev only ----
# When true (and NODE_ENV != production), OTPs are printed to the terminal and
# returned as `dev_code` in the send response, so you can test with no provider.
# MUST be false/unset in production.
AXDOX_DEV_ECHO=true

# ---- WhatsApp (Meta Cloud API) ----
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_AUTH_TEMPLATE_NAME=axdox_auth_code
WHATSAPP_WEBHOOK_VERIFY_TOKEN=change-me
WHATSAPP_APP_SECRET=

# ---- SMS providers (configure the ones you use) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_ID=
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_FROM=AXDOX
TELNYX_API_KEY=
TELNYX_MESSAGING_PROFILE_ID=
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SENDER_ID=
GUPSHUP_API_KEY=
GUPSHUP_SOURCE=

# ---- Email providers ----
EMAIL_FROM="AXDOX Verify <verify@axdox.com>"
RESEND_API_KEY=
SENDGRID_API_KEY=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---- Payments ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Monitoring ----
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
